# systemd unit for the Jetlink server. install.sh installs it with
# /etc/jetlink/server.env, which holds the settings below, and the server in
# /opt/jetlink/current, a link to the version's directory, so an update or a
# rollback is one rename. The installer also adds drop-ins: one that waits for
# the cache's mount, and on a Jetson one that runs jetson_clocks first.
#
# By hand, with a release tarball unpacked to /opt/jetlink/<version>:
#   sudo ln -sfn /opt/jetlink/<version> /opt/jetlink/current
#   sudo install -m 644 share/jetlink/systemd/jetlink-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now jetlink-server
#
# It runs as root: it is the USB host for the comma's gadget, writes
# /sys/power to sleep, arms the hubs for remote wakeup and powers off.
[Unit]
Description=Jetlink inference server
# in the car nobody is there to start it again
StartLimitIntervalSec=0

[Service]
Type=simple
# for an install by hand; server.env overrides them
Environment=JETLINK_CACHE_DIR=/var/lib/jetlink JETLINK_SLEEP_AFTER=0 JETLINK_STATUS_PORT=5600
EnvironmentFile=-/etc/jetlink/server.env
ExecStart=/opt/jetlink/current/bin/jetlink-server --usb --cache ${JETLINK_CACHE_DIR} --sleep-after ${JETLINK_SLEEP_AFTER} --status-port ${JETLINK_STATUS_PORT}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
